# Webhook de Make.com — copiá la URL del trigger "Custom Webhook" de tu escenario
# (valor de ejemplo: reemplazalo en .env.local y en Netlify; nunca subas la URL real al repositorio)
MAKE_WEBHOOK_URL=https://hook.REGION.make.com/ID_DEL_WEBHOOK

# API Key del webhook de Make (opcional). Si está definida se envía en el header x-make-apikey
MAKE_WEBHOOK_API_KEY=TU_API_KEY_DE_MAKE

# Número de WhatsApp de contacto (ya configurado en src/lib/contact.ts)
# NEXT_PUBLIC_WHATSAPP_NUMBER=5491170593618
